# LegalDocuMan Environment Configuration
# Copy this file to .env and fill in deployment-specific values.
# NEVER commit .env to git — it is already in .gitignore.
# Values below are placeholders/examples only; replace all production secrets.

# ============================================================================
# SaaS / Application Environment
# ============================================================================
APP_ENV=local
# Generate a strong unique value for shared/pilot/production environments.
SECRET_KEY=change-me-in-production
# Optional API key for private pilots. When set, /api/v1 routes require it via
# X-API-Key, Authorization: Bearer, or api_key query for downloads.
API_KEY=change-me-in-production

# Bootstrap admin creation. Use a real mailbox/password only in your private .env
# or secrets manager, not in this example file.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-in-production
BOOTSTRAP_TENANT_NAME=Default Tenant
AUTH_TOKEN_TTL_SECONDS=86400
DOWNLOAD_TOKEN_TTL_SECONDS=300

# Local-only escape hatch. Leave disabled for every shared/pilot deployment.
# When enabled and no API key/users exist, API routes are open for local setup.
ALLOW_OPEN_DEV_MODE=0

# Comma-separated allowed browser origins. Use exact HTTPS origins in SaaS.
CORS_ORIGINS=http://localhost:5000,http://localhost:5173

# In-memory per-client rate limits for private pilots/tests (single process only).
RATE_LIMIT_ENABLED=1
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=30

# ============================================================================
# Database, Queue, and Workers
# ============================================================================
# Docker Compose default:
DATABASE_URL=postgresql://postgres:postgres@db:5432/legaldocuman
# Local no-Docker development example:
# DATABASE_URL=sqlite:///legaldocuman.db

# Job backend: thread (local default), sync (tests/scripts), rq (Redis Queue worker).
JOB_BACKEND=rq
REDIS_URL=redis://redis:6379/0

# Docker Compose PostgreSQL/Redis published ports can be overridden if needed.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=legaldocuman
POSTGRES_PORT=5432
REDIS_PORT=6379
APP_PORT=5000

# ============================================================================
# Storage and Uploads
# ============================================================================
# Object storage: local or s3. For S3, configure AWS credentials in your runtime
# environment or secret manager; do not commit them.
STORAGE_BACKEND=local
UPLOAD_FOLDER=/project/uploads
PROCESSED_FOLDER=/project/processed
MAX_UPLOAD_MB=20
# S3_BUCKET=your-bucket-name
# S3_PREFIX=legaldocuman/uploads
# S3_REGION=us-east-1

# ============================================================================
# OCR Backend Selection
# ============================================================================
# Options: tesseract | nvidia
OCR_BACKEND=tesseract

# ============================================================================
# Local Tesseract OCR (used when OCR_BACKEND=tesseract)
# ============================================================================
# Override if Tesseract is not in your system PATH or installed in a custom location.
# Windows examples (uncomment one):
# TESSERACT_PATH=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
# TESSERACT_PATH=C:\\Program Files (x86)\\Tesseract-OCR\\tesseract.exe

# Override Poppler path for pdf2image (Windows example):
# POPPLER_PATH=C:\Users\<you>\Documents\poppler-24.08.0\Library\bin

# ============================================================================
# NVIDIA OCR Backend (used only when OCR_BACKEND=nvidia)
# ============================================================================
# Keep this commented until you intentionally enable NVIDIA OCR. Store the real
# key in .env or a secret manager only; never commit it.
# NVIDIA_API_KEY=nvapi-your-key-placeholder
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_OCR_MODEL=nvidia/nemotron-ocr-v2

# ============================================================================
# Security / Scanning
# ============================================================================
# Malware scanning: builtin detects EICAR/empty files; clamav shells out to clamscan.
MALWARE_SCANNER=builtin
# CLAMSCAN_PATH=clamscan

# ============================================================================
# RF-DETR Signature Detection
# ============================================================================
# Path to the RF-DETR checkpoint used for visual signature detection.
# Defaults to models/checkpoint_best_total.pth in the project root.
# RFDETR_MODEL_PATH=/path/to/checkpoint_best_total.pth

# ============================================================================
# Logging & Paths
# ============================================================================
# LOG_DIR=/custom/path/to/logs
# CONFIG_PATH=/custom/path/to/config.json
