# LegalDocuMan Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it is already in .gitignore.

# ============================================================================
# OCR Backend Selection
# ============================================================================
# Options: tesseract | nvidia
# Default: tesseract (local, free)
OCR_BACKEND=tesseract

# ============================================================================
# Local Tesseract OCR (used when OCR_BACKEND=tesseract)
# ============================================================================
# Override if Tesseract is not in your system PATH or installed in a custom location.
# Windows examples (uncomment one):
# TESSERACT_PATH=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
# TESSERACT_PATH=C:\\Program Files (x86)\\Tesseract-OCR\\tesseract.exe

# Override Poppler path for pdf2image (Windows example):
# POPPLER_PATH=C:\Users\<you>\Documents\poppler-24.08.0\Library\bin

# ============================================================================
# NVIDIA OCR Backend (used when OCR_BACKEND=nvidia)
# ============================================================================
# Get your API key from: https://build.nvidia.com/explore/
NVIDIA_API_KEY=nvapi-your-key-here

# NVIDIA API base URL — change only if using a private endpoint or regional mirror.
# Default: NGC (NVIDIA GPU Cloud)
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# Model identifier — update when NVIDIA releases newer OCR models.
NVIDIA_OCR_MODEL=nvidia/nemotron-ocr-v2

# ============================================================================
# Web Application
# ============================================================================
# Flask secret key (change in production)
# SECRET_KEY=your-secret-key-here

# Optional API key for pilot/shared deployments. When set, all /api/v1 routes
# require X-API-Key, Authorization: Bearer, or api_key query for downloads.
# API_KEY=change-me

# Comma-separated allowed browser origins for CORS. Leave empty for same-origin only.
# CORS_ORIGINS=http://localhost:5173,https://your-domain.example

# Job backend: thread (local default), sync (tests/scripts), rq (Redis Queue worker).
# For rq, set REDIS_URL and run an RQ worker for the documents queue.
# JOB_BACKEND=thread
# REDIS_URL=redis://localhost:6379/0

# Disable auto table creation when using Alembic migrations in shared environments.
# AUTO_CREATE_DB=0

# User/RBAC bootstrap. Set these once before first startup to create the first admin.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me
# BOOTSTRAP_TENANT_NAME=Default Tenant
# AUTH_TOKEN_TTL_SECONDS=86400

# Malware scanning: builtin detects EICAR/empty files; clamav shells out to clamscan.
# MALWARE_SCANNER=builtin
# CLAMSCAN_PATH=clamscan

# Object storage: local or s3. For S3, configure AWS credentials in the environment.
# STORAGE_BACKEND=local
# S3_BUCKET=your-bucket
# S3_PREFIX=legaldocuman/uploads
# S3_REGION=us-east-1

# PostgreSQL database URL

# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legaldocuman
# Local no-Docker development example:
# DATABASE_URL=sqlite:///legaldocuman.db

# Upload folder for documents
# UPLOAD_FOLDER=./uploads

# Maximum upload size in megabytes
# MAX_UPLOAD_MB=20

# ============================================================================
# RF-DETR Signature Detection
# ============================================================================
# Path to the RF-DETR checkpoint used for visual (handwritten) signature detection.
# Defaults to models/checkpoint_best_total.pth in the project root.
# Leave unset to use the default; override if you store the model elsewhere.
# RFDETR_MODEL_PATH=/path/to/checkpoint_best_total.pth

# ============================================================================
# Logging & Paths
# ============================================================================
# Override default log directory (default: ~/Documents/DocumentProcessorLogs)
# LOG_DIR=/custom/path/to/logs

# Override default config file location
# CONFIG_PATH=/custom/path/to/config.json
